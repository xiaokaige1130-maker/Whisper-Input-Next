# Whisper-Input-Next environment template.
# Copy this file to .env and fill in only the services you use.

# ============ Transcription service ============
TRANSCRIPTION_SERVICE=aliyun
BATCH_TRANSCRIPTION_SERVICE=aliyun
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_ASR_ENABLE_ITN=true

# Optional OpenAI batch transcription / translation.
OFFICIAL_OPENAI_API_KEY=

# ============ Real-time translation ============
# ASR first converts speech to text, then Qwen-MT translates the final text.
TRANSLATION_SERVICE=aliyun
TRANSLATION_TARGET_LANGUAGE=en
DASHSCOPE_TRANSLATION_MODEL=qwen-mt-flash
# Right Command on the Apple keyboard used by 小凯哥语音输入法.
TRANSLATION_HOTKEY=cmd_r
TRANSLATION_HOTKEY_MODE=hold

# ============ Persona rewriting ============
# Qwen reuses DASHSCOPE_API_KEY; Ark uses a separate Ark API Key.
PERSONA_REWRITE_ENABLED=false
PERSONA_ACTIVE_ID=
PERSONA_REWRITE_PROVIDER=qwen
PERSONA_FALLBACK_PROVIDER=ark
QWEN_REWRITE_MODEL=qwen-flash
QWEN_TIMEOUT_SECONDS=30
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_REWRITE_MODEL=doubao-seed-2-0-mini-260428
ARK_TIMEOUT_SECONDS=20
PERSONA_MAX_TOKENS=800
PERSONA_TEMPERATURE=0.35

# Optional local whisper.cpp mode for Win+I.
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=models/ggml-large-v3.bin

# ============ Keyboard and platform ============
TRANSCRIPTIONS_BUTTON=f
# Modifier aliases include win/windows/super, ctrl/control, and cmd/command.
TRANSLATIONS_BUTTON=win
# Single-key transcription trigger. Hold Right Alt to record, release to transcribe.
TRANSCRIPTION_HOTKEY=alt_r
# toggle: press once to start, press again to stop. hold: press and hold to record, release to stop.
TRANSCRIPTION_HOTKEY_MODE=hold
# mac / linux / win
SYSTEM_PLATFORM=linux

# Default paste hotkey: linux=ctrl+shift+v, win=ctrl+v, mac=cmd+v.
# For non-terminal Linux apps, use PASTE_HOTKEY=ctrl+v if needed.
# PASTE_HOTKEY=ctrl+v

# ============ Feature switches ============
CONVERT_TO_SIMPLIFIED=false
CLEAN_ASR_FILLERS=true
ADD_SYMBOL=false
OPTIMIZE_RESULT=false
ENABLE_KIMI_POLISH=false
AUTO_RETRY_LIMIT=5
AUDIO_ARCHIVE_MODE=off

# ============ Status bar icons ============
# STATUS_ICON_IDLE=/path/to/idle.png
# STATUS_ICON_RECORDING=/path/to/recording.png
# STATUS_ICON_PROCESSING=/path/to/transcripting.png
# STATUS_ICON_TEMPLATE=true

# ============ Legacy compatible providers ============
GROQ_API_KEY=
GROQ_BASE_URL=
SILICONFLOW_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
